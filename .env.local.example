# ─── Animov.ai — Environment Variables ───
# Copy to .env.local and fill in values

# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── fal.ai (SERVER ONLY — never expose to client) ───
FAL_KEY=

# ─── OpenRouter (Vision LLM for prompt generation) ───
OPENROUTER_API_KEY=

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Stripe (test keys for development) ───
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret. Local: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# and copy the `whsec_...` it prints. Prod: copy it from the registered endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Notifications (optional) ───
# Slack/Discord-style incoming webhook URL; founder gets a ping on each purchase/renewal. Leave empty to disable.
FOUNDER_NOTIFY_WEBHOOK=

# ─── Cron (Workstream B queue dispatcher) ───
# Shared secret guarding /api/cron/dispatch. Vercel Cron sends `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
